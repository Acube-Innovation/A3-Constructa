# A3 Constructa — development reverse proxy.
#
# Two jobs only: put the whole thing on one port under one hostname, and send
# /socket.io to the realtime server instead of the web server. Everything else
# — pages, /api, /assets, /files — goes to the Frappe development server, which
# serves its own static files and reloads itself when a .py file changes.
#
# ${SITE_NAME}, ${BACKEND} and ${SOCKETIO} are filled in from the environment by
# the nginx image's own template step. $host, $uri and friends are nginx's and
# survive it, because no environment variable is named after them.

map $http_upgrade $connection_upgrade {
	default upgrade;
	''      close;
}

server {
	listen 80 default_server;
	server_name ${SITE_NAME} localhost 127.0.0.1;

	# Frappe streams backups and accepts file uploads; the 1 MB default is not
	# enough for either.
	client_max_body_size 100m;

	# Docker's embedded DNS, consulted per request rather than at startup, so
	# nginx comes up even when a bench container is still starting.
	resolver 127.0.0.11 valid=10s ipv6=off;

	# Which site this bench should answer as. The bench holds one site, and
	# naming it here means http://localhost:8092 works as well as
	# http://constructa.localhost:8092.
	proxy_set_header X-Frappe-Site-Name ${SITE_NAME};
	proxy_set_header Host $host;
	proxy_set_header X-Real-IP $remote_addr;
	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_set_header X-Forwarded-Host $host;

	location /socket.io {
		set $socketio ${SOCKETIO};
		proxy_pass http://$socketio;
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection $connection_upgrade;
		proxy_read_timeout 3600s;
	}

	location / {
		set $backend ${BACKEND};
		proxy_pass http://$backend;
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection $connection_upgrade;
		# A long report or a migrate run through the UI can sit for minutes.
		proxy_read_timeout 600s;
		proxy_send_timeout 600s;
		proxy_buffering off;
	}
}
