# A3 Constructa — local development environment.
#
# Copy to `.env` and fill in the two passwords before the first `docker
# compose up -d`. The real `.env` is git-ignored: these are local development
# credentials and nothing here belongs in a repository or on a server.
#
#     cp .env.example .env

# --- credentials -----------------------------------------------------------
# MariaDB's root password. The bootstrap uses it to create the site database,
# and nothing else does.
MARIADB_ROOT_PASSWORD=change-me

# The password for the site's `Administrator` login.
ADMIN_PASSWORD=change-me

# --- the site --------------------------------------------------------------
SITE_NAME=constructa.localhost

# --- versions --------------------------------------------------------------
# Kept in step with pyproject.toml (frappe/erpnext >=15,<16). Change them
# together, never one alone.
FRAPPE_BRANCH=version-15
ERPNEXT_BRANCH=version-15
HRMS_BRANCH=version-15

# --- the demo company the ERPNext setup wizard creates ---------------------
# A bare Frappe site has no UOMs, item groups or price lists — those come from
# the setup wizard, and the app's installer needs them. The bootstrap runs the
# wizard once, with these values. Set SETUP_WIZARD=0 to skip it and run the
# wizard yourself in the browser instead.
SETUP_WIZARD=1
COMPANY_NAME="A3 Constructa Demo"
COMPANY_ABBR=A3C
COUNTRY=India
CURRENCY=INR
TIMEZONE=Asia/Kolkata

# --- ports on the Windows host ---------------------------------------------
# Chosen to clear the a3-optics (80/8000/3306), a3-retail (8090/8001/3307),
# a3-loan (8091/8002/3308) and erpnext15 (8010) stacks already on this machine.
#
# The browser URL: http://constructa.localhost:8092/
HTTP_PORT=8092
# The development server, straight through, bypassing nginx.
BACKEND_PORT=8003
# MariaDB, bound to 127.0.0.1 only, for a GUI client on Windows.
DB_PORT=3309
